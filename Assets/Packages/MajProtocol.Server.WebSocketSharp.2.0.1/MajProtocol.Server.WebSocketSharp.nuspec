<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MajProtocol.Server.WebSocketSharp</id>
    <version>2.0.1</version>
    <authors>re-poem, fumiko</authors>
    <license type="expression">GPL-3.0-only</license>
    <licenseUrl>https://licenses.nuget.org/GPL-3.0-only</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/re-poem/MajProtocol</projectUrl>
    <description>WebSocket server implementation of MajProtocol, used by a player to receive playback control from a client.</description>
    <tags>simai majdata protocol websocket binary-protocol</tags>
    <repository type="git" url="https://github.com/re-poem/MajProtocol.git" branch="refs/heads/master" commit="b81e24ecd8c632fca41393fa01274750b9999665" />
    <dependencies>
      <group targetFramework=".NETStandard2.1">
        <dependency id="MajProtocol.Standard" version="2.0.1" exclude="Build,Analyzers" />
        <dependency id="WebSocketSharp-netstandard" version="1.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>